# Backend API Base URL
# Default for local development:
VITE_API_BASE_URL=http://localhost:8080

# For Render production deployment, set in Render Environment Variables:
# VITE_API_BASE_URL=https://swift-mx-message.onrender.com

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> Credentials)
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
